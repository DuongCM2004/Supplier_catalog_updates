#!/bin/sh
# Rejects commit messages a technical reviewer could not follow from `git log` alone.
# Format: <type>(<scope>): <behaviour summary>, plus Why:/How:/Verified: for code changes.
# Enable once per clone: git config core.hooksPath .githooks

msg_file="$1"
# Drop comment lines git adds in editor mode.
body=$(grep -v '^#' "$msg_file")
subject=$(printf '%s\n' "$body" | sed -n '1p')

fail() {
  echo "commit-msg: $1" >&2
  echo "commit-msg: subject was: $subject" >&2
  exit 1
}

# Git-generated merge/revert subjects are left alone.
case "$subject" in
  Merge\ *|Revert\ *) exit 0 ;;
esac

types='feat|fix|refactor|perf|test|docs|chore|ci|build|merge'
scopes='contracts|storage|migrations|catalog|supplier|syncjob|api|server|fixtures|test|scripts|infra|docs'

printf '%s\n' "$subject" | grep -Eq "^($types)(\(($scopes)\))?: .{10,}$" ||
  fail "subject must be '<type>(<scope>): <summary of at least 10 chars>' (types: $types; scopes: $scopes)"

[ "${#subject}" -le 72 ] || fail "subject is ${#subject} chars; keep it to 72"

summary=$(printf '%s\n' "$subject" | sed 's/^[^:]*: //')
printf '%s\n' "$summary" | grep -Eiq '^(wip|misc|stuff|changes|update( code| files)?|fix bugs?|minor fixes)\b' &&
  fail "subject is too vague; describe the behaviour that changed"

type=$(printf '%s\n' "$subject" | sed -E 's/^([a-z]+).*/\1/')
case "$type" in
  feat|fix|refactor|perf)
    for section in 'Why:' 'How:' 'Verified:'; do
      printf '%s\n' "$body" | grep -q "^$section" ||
        fail "'$type' commits need a '$section' section in the body"
    done
    ;;
esac

# Planning identifiers mean nothing to a reader of the public history.
printf '%s\n' "$body" | grep -Eq '\b(FND|CAT|SUP|JOB|PRC|WRK|API|SEC|OBS|QA|DEL|DEP|INT|STB)-[0-9]{2}\b|\bINV-[0-9]\b|\bAPI-T[0-9]{2}\b|\bU-[A-Z]{2,4}-[A-Z]?[0-9]{2}\b|\bI-[A-Z]{3}-[0-9]{2}\b|\bFI-[0-9]\b' &&
  fail "remove planning IDs (task, test-matrix or invariant labels); describe the behaviour instead"

printf '%s\n' "$body" | grep -Eiq '^co-authored-by:.*(claude|anthropic|openai|chatgpt|copilot)|generated (with|by) .*(claude|chatgpt|copilot|\bai\b)|noreply@anthropic\.com' &&
  fail "remove AI attribution lines"

exit 0

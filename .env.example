# Copy to .env before `docker compose up` (never commit .env). All values are safe local defaults.

# Host ports. The API container listens on 8080 and PostgreSQL on 5432 inside the network;
# these defaults avoid clashing with a PostgreSQL or web server already running on the host.
APP_PORT=8088
DB_PORT=55432

# Leave empty locally. When set, POST routes require "Authorization: Bearer <API_TOKEN>".
API_TOKEN=

LOG_LEVEL=info

# Fault injection for demos and tests only; keep empty in normal use.
#   SUPPLIER_OUTAGE_CURSORS  comma list of cursors the fixture supplier always fails on
#   SUPPLIER_DELAY_MS        pause before each supplier fetch (lets you stop the app mid-run)
#   CRASH_POINT              before_commit:<batch_id> or after_commit:<batch_id> exits the app there
SUPPLIER_OUTAGE_CURSORS=
SUPPLIER_DELAY_MS=0
CRASH_POINT=

# The compose project is named "catalog-sync" (see compose.yaml). Set COMPOSE_PROJECT_NAME
# to run a second, isolated stack. WARNING: `docker compose down -v` deletes the pgdata
# volume, i.e. the whole catalog and job history of that project.
